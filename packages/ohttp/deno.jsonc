{
  "name": "@hpke/ohttp",
  "version": "0.2.0",
  "exports": {
    ".": "./mod.ts",
    "./node": "./node.ts"
  },
  "publish": {
    "exclude": [
      "CHANGES.md",
      "dnt.ts",
      "samples/",
      "test/",
      "tsconfig.docs.json",
      "tsconfig.json"
    ]
  },
  "fmt": {
    "include": [
      "**/*.md",
      "**/*.json",
      "dnt.ts",
      "mod.ts",
      "*.ts",
      "samples/",
      "src/",
      "test/"
    ],
    "exclude": [
      "**/*/*.js",
      "**/*/npm/",
      "coverage/*.json",
      "test/runtimes/fastly/"
    ]
  },
  "lint": {
    "include": [
      "**/*.md",
      "**/*.json",
      "dnt.ts",
      "mod.ts",
      "*.ts",
      "samples/",
      "src/",
      "test/"
    ],
    "exclude": [
      "**/*/*.js",
      "**/*/npm/",
      "coverage/*.json",
      "test/runtimes/fastly/"
    ]
  },
  "tasks": {
    "test": "deno fmt && deno lint && deno task check && deno test --fail-fast --doc --coverage=coverage --parallel --allow-read --allow-net && deno task test:integration",
    "test:cloudflare": "cd test/runtimes/cloudflare && npm install && npm link @hpke/ohttp && npm run test",
    "test:fastly": "cd test/runtimes/fastly && npm install && npm link @hpke/ohttp && npm run test",
    "test:bun": "cd test/runtimes/bun && bun install && bun test",
    "check": "deno check *.ts src/**/*.ts test/*.ts",
    "cov": "deno coverage ./coverage --lcov --exclude='test'",
    "npm-build": "deno run --import-map=../../npm/import_map.json -A dnt.ts --skip-test",
    "dnt": "deno run --import-map=../../npm/import_map.json -A dnt.ts",
    "test:integration": "deno test --allow-net test/http.integration.ts test/node.integration.ts"
  }
}
